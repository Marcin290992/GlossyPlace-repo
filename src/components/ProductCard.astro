---
import { Image } from "astro:assets";

interface Props {
	id: string;
	label: string;
	image?: ImageMetadata | null;
	price: string;
}

const { id, label, image, price } = Astro.props;
---

<div class="card">
	<a href={`/shop/${id}`} class="card-link">
		<div class="card-image">
			{image && <Image src={image} alt={label} class="card-image-photo" />}
		</div>
		<p class="card-label">{label}</p>
	</a>
	<p class="card-price">{price}</p>
	<button type="button" class="add-to-bag" data-add-id={id}>
		Add to bag
	</button>
</div>

<style>
	.card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.card-link {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		color: inherit;
		text-decoration: none;
	}

	.card-image {
		position: relative;
		align-self: stretch;
		width: 100%;
		aspect-ratio: 3 / 4;
		background: #f4f0ea;
		overflow: hidden;
	}

	.card-image-photo {
		position: absolute;
		top: 10%;
		left: 10%;
		width: 80%;
		height: 80%;
		object-fit: contain;
	}

	.card-label {
		margin: 0;
		text-align: center;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	.card-price {
		margin: 0;
		text-align: center;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
	}

	.add-to-bag {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid #111827;
		background: transparent;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	@media (hover: hover) {
		.add-to-bag:hover {
			background: #111827;
			color: #fff;
		}
	}

	.add-to-bag[data-added="true"] {
		border-color: #b8a68a;
		background: #b8a68a;
		color: #fff;
	}
</style>
