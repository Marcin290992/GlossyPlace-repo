---
import { Image } from "astro:assets";
import { products } from "../data/products";
import { productImages } from "../data/productImages";
import { formatPrice } from "../lib/format";

const bracelets = products.map((product) => ({
	id: product.id,
	label: product.name,
	image: productImages[product.id] ?? null,
	price: formatPrice(product.priceInPence),
}));
---

<section class="our-collections">
	<h2 class="our-collections-title">Find Your Ritual</h2>
	<div class="cards-grid">
		{
			bracelets.map((bracelet) => (
				<div class="card">
					<a href={`/shop/${bracelet.id}`} class="card-link">
						<div class="card-image">
							{bracelet.image && <Image src={bracelet.image} alt={bracelet.label} class="card-image-photo" />}
						</div>
						<p class="card-label">{bracelet.label}</p>
					</a>
					<p class="card-price">{bracelet.price}</p>
					<button type="button" class="add-to-bag" data-add-id={bracelet.id}>
						Add to bag
					</button>
				</div>
			))
		}
	</div>
</section>

<style>
	.our-collections {
		display: flex;
		width: 100%;
		padding: 120px 64px 163.2px 64px;
		flex-direction: column;
		align-items: flex-start;
		gap: 32px;
	}

	.our-collections-title {
		width: 1312px;
		max-width: 100%;
		margin: 0;
		color: #111;
		font-family: "Cormorant Garamond", serif;
		font-size: 36px;
		font-style: normal;
		font-weight: 400;
		line-height: normal;
		letter-spacing: 4px;
		text-transform: uppercase;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		align-items: start;
		align-self: stretch;
		gap: 16px;
	}

	.card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.card-link {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		color: inherit;
		text-decoration: none;
	}

	@media (max-width: 1024px) {
		.our-collections {
			padding: 64px 24px 80px 24px;
			gap: 20px;
		}

		.our-collections-title {
			font-size: 26px;
			letter-spacing: 2px;
		}

		.cards-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.card:last-child {
			display: none;
		}
	}

	.card-image {
		position: relative;
		align-self: stretch;
		width: 100%;
		aspect-ratio: 3 / 4;
		background: #f4f0ea;
		overflow: hidden;
	}

	.card-image-photo {
		position: absolute;
		top: 10%;
		left: 10%;
		width: 80%;
		height: 80%;
		object-fit: contain;
	}

	.card-label {
		margin: 0;
		text-align: center;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	.card-price {
		margin: 0;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
	}

	.add-to-bag {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid #111827;
		background: transparent;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.add-to-bag:hover {
		background: #111827;
		color: #fff;
	}

	.add-to-bag[data-added="true"] {
		border-color: #b8a68a;
		background: #b8a68a;
		color: #fff;
	}
</style>

<script>
	import { addToCart, openCartDrawer } from "../lib/cart";

	document.querySelectorAll<HTMLButtonElement>("[data-add-id]").forEach((button) => {
		const defaultLabel = button.textContent ?? "Add to bag";
		let revertTimeout: number | undefined;

		button.addEventListener("click", () => {
			const id = button.dataset.addId;
			if (!id) return;

			addToCart(id);
			openCartDrawer();

			button.dataset.added = "true";
			button.textContent = "Added";

			clearTimeout(revertTimeout);
			revertTimeout = window.setTimeout(() => {
				delete button.dataset.added;
				button.textContent = defaultLabel;
			}, 1500);
		});
	});
</script>
