---
import { Image } from "astro:assets";
import { products } from "../data/products";
import { productImages } from "../data/productImages";
import { formatPrice } from "../lib/format";

const items = products
	.filter((product) => product.collection === "discover-collection")
	.map((product) => ({
		id: product.id,
		label: product.name,
		image: productImages[product.id] ?? null,
		price: formatPrice(product.priceInPence),
	}));
---

<section class="discover-collection">
	<h2 class="discover-collection-title">Discover Collection</h2>
	<div class="discover-cards-grid">
		{
			items.map((item) => (
				<div class="discover-card">
					<a href={`/shop/${item.id}`} class="discover-card-image-link">
						<div class="discover-card-image">
							{item.image && <Image src={item.image} alt={item.label} class="discover-card-photo" />}
							<p class="discover-card-name">{item.label}</p>
						</div>
					</a>
					<div class="discover-card-footer">
						<p class="discover-card-price">{item.price}</p>
						<button type="button" class="add-to-bag" data-add-id={item.id}>
							Add to bag
						</button>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.discover-collection {
		display: flex;
		width: 100%;
		padding: 120px 64px 140px;
		flex-direction: column;
		align-items: flex-start;
		gap: 32px;
	}

	.discover-collection-title {
		margin: 0;
		color: #111;
		font-family: "Cormorant Garamond", serif;
		font-size: 36px;
		font-weight: 400;
		letter-spacing: 4px;
		text-transform: uppercase;
	}

	.discover-cards-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		align-self: stretch;
		gap: 16px;
	}

	.discover-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 12px;
	}

	.discover-card-image-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.discover-card-image {
		position: relative;
		aspect-ratio: 250 / 333;
		background: #f4f0ea;
		overflow: hidden;
	}

	.discover-card-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.discover-card-name {
		position: absolute;
		left: 16px;
		bottom: 16px;
		max-width: calc(100% - 32px);
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-weight: 500;
		font-size: 18px;
	}

	.discover-card-footer {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.discover-card-price {
		margin: 0;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
	}

	.add-to-bag {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid #111827;
		background: transparent;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.add-to-bag:hover {
		background: #111827;
		color: #fff;
	}

	.add-to-bag[data-added="true"] {
		border-color: #b8a68a;
		background: #b8a68a;
		color: #fff;
	}

	@media (max-width: 1024px) {
		.discover-collection {
			padding: 64px 24px 80px;
			gap: 20px;
		}

		.discover-collection-title {
			font-size: 26px;
			letter-spacing: 2px;
		}

		.discover-cards-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>

<script>
	import { initAddToBagButtons } from "../lib/cart";

	initAddToBagButtons(document.querySelector(".discover-collection") ?? document);
</script>
