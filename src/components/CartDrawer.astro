---
import { getImage } from "astro:assets";
import { productImages } from "../data/productImages";

const imageMap: Record<string, string> = {};
for (const [id, image] of Object.entries(productImages)) {
	const optimized = await getImage({ src: image, width: 160 });
	imageMap[id] = optimized.src;
}
---

<div id="cart-drawer-backdrop" class="cart-drawer-backdrop"></div>
<aside id="cart-drawer" class="cart-drawer" aria-hidden="true" aria-label="Shopping bag">
	<div class="cart-drawer-header">
		<p class="cart-drawer-title">Your Bag</p>
		<button type="button" id="cart-drawer-close" class="cart-drawer-close" aria-label="Close bag">✕</button>
	</div>

	<div id="cart-drawer-body" class="cart-drawer-body"></div>

	<div class="cart-drawer-footer">
		<div class="cart-drawer-subtotal-row">
			<span>Subtotal</span>
			<span id="cart-drawer-subtotal"></span>
		</div>
		<a href="/cart" class="cart-drawer-view-bag">View bag</a>
		<button type="button" class="cart-drawer-checkout" disabled title="Coming soon">Checkout — coming soon</button>
	</div>
</aside>

<div id="cart-drawer-image-data" data-images={JSON.stringify(imageMap)} hidden></div>

<style>
	.cart-drawer-backdrop {
		position: fixed;
		inset: 0;
		z-index: 900;
		background: rgba(17, 24, 39, 0.4);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.cart-drawer-backdrop.open {
		opacity: 1;
		pointer-events: auto;
	}

	.cart-drawer {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 901;
		width: 100%;
		max-width: 400px;
		height: 100%;
		display: flex;
		flex-direction: column;
		background: #fff;
		box-shadow: -8px 0 24px rgba(17, 24, 39, 0.12);
		transform: translateX(100%);
		transition: transform 0.3s ease;
	}

	.cart-drawer.open {
		transform: translateX(0);
	}

	@media (max-width: 640px) {
		.cart-drawer {
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			max-width: 100%;
			height: auto;
			max-height: 85vh;
			box-shadow: 0 -8px 24px rgba(17, 24, 39, 0.12);
			transform: translateY(100%);
		}

		.cart-drawer.open {
			transform: translateY(0);
		}
	}

	.cart-drawer-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 24px;
		border-bottom: 1px solid #e5e7eb;
	}

	.cart-drawer-title {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 22px;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.cart-drawer-close {
		border: none;
		background: none;
		color: #111827;
		font-size: 16px;
		cursor: pointer;
		line-height: 1;
	}

	.cart-drawer-body {
		flex: 1;
		overflow-y: auto;
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.cart-drawer-empty {
		margin: 40px 0 0;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 14px;
		text-align: center;
	}

	.cart-drawer-footer {
		padding: 24px;
		border-top: 1px solid #e5e7eb;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.cart-drawer-subtotal-row {
		display: flex;
		justify-content: space-between;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 14px;
		font-weight: 500;
	}

	.cart-drawer-view-bag {
		display: block;
		text-align: center;
		padding: 12px;
		border: 1px solid #111827;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-decoration: none;
	}

	.cart-drawer-checkout {
		padding: 14px;
		border: 1px solid #111827;
		background: #111827;
		color: #fff;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 1px;
		text-transform: uppercase;
		cursor: not-allowed;
		opacity: 0.5;
	}
</style>

<style is:global>
	.cart-drawer-item {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.cart-drawer-item-image {
		flex-shrink: 0;
		width: 64px;
		height: 80px;
		background: #f4f0ea;
		overflow: hidden;
	}

	.cart-drawer-item-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.cart-drawer-item-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.cart-drawer-item-name {
		margin: 0;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 13px;
		font-weight: 500;
	}

	.cart-drawer-item-price {
		margin: 0;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
	}

</style>

<script>
	import { getCartItems, getCartSubtotalPence, addToCart, setQuantity, CART_EVENT, CART_OPEN_EVENT } from "../lib/cart";
	import { formatPrice } from "../lib/format";

	const drawer = document.getElementById("cart-drawer");
	const backdrop = document.getElementById("cart-drawer-backdrop");
	const closeButton = document.getElementById("cart-drawer-close");
	const body = document.getElementById("cart-drawer-body");
	const subtotalEl = document.getElementById("cart-drawer-subtotal");
	const dataEl = document.getElementById("cart-drawer-image-data");
	const imageMap: Record<string, string> = dataEl ? JSON.parse(dataEl.dataset.images || "{}") : {};

	function render() {
		if (!body || !subtotalEl) return;

		const items = getCartItems();
		body.innerHTML = "";

		if (items.length === 0) {
			body.innerHTML = `<p class="cart-drawer-empty">Your bag is empty.</p>`;
		} else {
			items.forEach(({ product, quantity }) => {
				const row = document.createElement("div");
				row.className = "cart-drawer-item";
				const image = imageMap[product.id];
				row.innerHTML = `
					<div class="cart-drawer-item-image">${image ? `<img src="${image}" alt="${product.name}">` : ""}</div>
					<div class="cart-drawer-item-info">
						<p class="cart-drawer-item-name">${product.name}</p>
						<p class="cart-drawer-item-price">${formatPrice(product.priceInPence)}</p>
					</div>
					<div class="qty-stepper">
						<button type="button" class="qty-btn" data-qty-minus="${product.id}" aria-label="Decrease quantity of ${product.name}">−</button>
						<span class="qty-value">${quantity}</span>
						<button type="button" class="qty-btn" data-qty-plus="${product.id}" aria-label="Increase quantity of ${product.name}">+</button>
					</div>
				`;
				body.appendChild(row);
			});
		}

		subtotalEl.textContent = formatPrice(getCartSubtotalPence());

		body.querySelectorAll<HTMLButtonElement>("[data-qty-minus]").forEach((button) => {
			button.addEventListener("click", () => {
				const id = button.dataset.qtyMinus;
				if (!id) return;
				const current = getCartItems().find((item) => item.product.id === id)?.quantity ?? 0;
				setQuantity(id, current - 1);
			});
		});

		body.querySelectorAll<HTMLButtonElement>("[data-qty-plus]").forEach((button) => {
			button.addEventListener("click", () => {
				const id = button.dataset.qtyPlus;
				if (id) addToCart(id, 1);
			});
		});
	}

	function openDrawer() {
		render();
		drawer?.classList.add("open");
		backdrop?.classList.add("open");
		drawer?.setAttribute("aria-hidden", "false");
		document.body.classList.add("no-scroll");
	}

	function closeDrawer() {
		drawer?.classList.remove("open");
		backdrop?.classList.remove("open");
		drawer?.setAttribute("aria-hidden", "true");
		document.body.classList.remove("no-scroll");
	}

	closeButton?.addEventListener("click", closeDrawer);
	backdrop?.addEventListener("click", closeDrawer);
	document.addEventListener("keydown", (event) => {
		if (event instanceof KeyboardEvent && event.key === "Escape") closeDrawer();
	});

	window.addEventListener(CART_OPEN_EVENT, openDrawer);
	window.addEventListener(CART_EVENT, render);
	render();
</script>
