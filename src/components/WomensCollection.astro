---
// Placeholder photo from Unsplash — swap for real lifestyle photography once available.
const imageUrl = "https://images.unsplash.com/photo-1770294760762-1cd821ecc567?w=2400&q=80&fm=jpg&fit=crop";
---

<section class="womens-collection">
	<img
		src={imageUrl}
		alt="Woman relaxing in silk loungewear wearing a Glossy Place bracelet"
		class="womens-collection-image"
		loading="lazy"
	/>
	<div class="womens-collection-card">
		<p class="womens-collection-title">Women's Collection</p>
		<a href="/shop" class="womens-collection-link">Shop the Collection</a>
	</div>
</section>

<style>
	.womens-collection {
		position: relative;
		width: 100%;
		height: 400px;
		overflow: hidden;
	}

	@media (min-width: 1025px) {
		.womens-collection {
			height: 500px;
		}
	}

	.womens-collection-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
	}

	.womens-collection-card {
		position: absolute;
		left: 24px;
		bottom: 24px;
		max-width: min(440px, calc(100% - 48px));
		padding: 20px 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		text-align: center;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.6);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.womens-collection-title {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-weight: 400;
		font-size: 28px;
		line-height: 1.1;
		letter-spacing: -0.5px;
	}

	@media (min-width: 1025px) {
		.womens-collection-title {
			font-size: 48px;
		}
	}

	.womens-collection-link {
		margin: 0;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-weight: 600;
		font-size: 11px;
		letter-spacing: 2.5px;
		text-transform: uppercase;
		text-decoration: underline;
	}

	.womens-collection-link:hover,
	.womens-collection-link:focus-visible {
		opacity: 0.7;
	}
</style>
