---
interface Props {
	variant: "iris" | "wipe" | "curtain" | "slats" | "grid" | "type";
	src: string;
	alt?: string;
	word?: string;
	feather?: number;
	columns?: number;
	originX?: number;
	originY?: number;
	angle?: number;
	stagger?: number;
	overlay?: number;
	zoom?: number;
	fit?: "cover" | "contain";
	scrollLength?: number;
	settle?: number;
	smooth?: number;
	revealContent?: boolean;
	contentFrom?: number;
	contentTo?: number;
	contentAlign?: "center" | "bottom";
	scrimStyle?: "flat" | "bottom";
	introFadeTo?: number;
	calm?: boolean;
	maxWidth?: number;
	ratio?: string;
}

const {
	variant,
	src,
	alt = "",
	word,
	feather,
	columns,
	originX,
	originY,
	angle,
	stagger,
	overlay,
	zoom,
	fit,
	scrollLength,
	settle,
	smooth,
	revealContent,
	contentFrom,
	contentTo,
	contentAlign,
	scrimStyle,
	introFadeTo,
	calm,
	maxWidth = 1000,
	ratio = "3 / 2",
} = Astro.props;
---

<section
	class="scroll-mask"
	style={`--mask-max-width: ${maxWidth}px; --mask-ratio: ${ratio};`}
	data-variant={variant}
	data-src={src}
	data-alt={alt}
	data-word={word}
	data-feather={feather}
	data-columns={columns}
	data-origin-x={originX}
	data-origin-y={originY}
	data-angle={angle}
	data-stagger={stagger}
	data-overlay={overlay}
	data-zoom={zoom}
	data-fit={fit}
	data-scroll-length={scrollLength}
	data-settle={settle}
	data-smooth={smooth}
	data-reveal-content={revealContent === undefined ? undefined : String(revealContent)}
	data-content-from={contentFrom}
	data-content-align={contentAlign}
	data-scrim-style={scrimStyle}
	data-content-to={contentTo}
	data-intro-fade-to={introFadeTo}
	data-calm={calm === undefined ? undefined : String(calm)}
>
	<div class="scroll-mask-intro-slot">
		<slot name="intro" />
	</div>
	<slot />
</section>

<style is:global>
	/* Base scroll-mask engine styles — markup is built client-side, so these must be global. */
	.scroll-mask {
		position: relative;
		width: 100%;
		min-height: 100vh;
	}

	/* Before the script below runs, the section still holds its raw,
	   unpositioned children (intro text, reveal quote) — hide everything
	   except the built pin so there's no flash of unstyled content. */
	.scroll-mask > *:not(.scroll-mask__pin) {
		display: none;
	}

	.scroll-mask__pin {
		position: sticky;
		/* Matches the sticky announcement bar (35px) + navbar (76px) above it,
		   so the pin locks in place immediately instead of drifting up the
		   first ~111px of scroll before it engages. */
		top: 111px;
		display: flex;
		height: calc(100vh - 111px);
		width: 100%;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}

	@media (min-width: 640px) {
		.scroll-mask__pin {
			padding: 64px;
		}
	}

	.scroll-mask__stage {
		position: relative;
		width: 100%;
		max-width: var(--mask-max-width, 1000px);
		max-height: calc(100vh - 48px);
		aspect-ratio: var(--mask-ratio, 3 / 2);
		overflow: hidden;
		/* Promotes the clipping box to its own compositing layer so its edge
		   is pixel-snapped consistently with the animated children inside it
		   — without this, fractional device pixel ratios (common on Android)
		   can show a hairline seam along the bottom edge during scroll. */
		transform: translateZ(0);
	}

	@media (min-width: 640px) {
		.scroll-mask__stage {
			max-height: calc(100vh - 128px);
		}
	}

	@media (max-width: 640px) {
		/* Whatever ratio a section uses on desktop (some are landscape, e.g.
		   the word-mask/wipe sections), a short landscape box on a narrow
		   phone screen leaves huge empty gaps above and below it. Force a
		   taller, screen-filling ratio on mobile across every variant. */
		.scroll-mask__stage {
			aspect-ratio: 4 / 5;
		}
	}

	.scroll-mask__tiles {
		position: absolute;
		inset: 0;
	}

	.scroll-mask__tile {
		position: absolute;
		will-change: transform;
	}

	.scroll-mask__veil {
		position: absolute;
		inset: 0;
	}

	.scroll-mask__image {
		position: absolute;
		inset: 0;
		height: 100%;
		width: 100%;
		user-select: none;
		-webkit-user-select: none;
		will-change: transform;
	}

	.scroll-mask__scrim {
		pointer-events: none;
		position: absolute;
		inset: 0;
	}

	.scroll-mask__content {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		will-change: transform;
	}

	.scroll-mask__content--bottom {
		align-items: flex-end;
		padding-bottom: 32px;
	}

	.scroll-mask__intro {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		text-align: center;
		will-change: opacity;
	}

	@media (min-width: 640px) {
		.scroll-mask__content {
			padding: 64px;
		}

		.scroll-mask__content--bottom {
			padding-bottom: 48px;
		}

		.scroll-mask__intro {
			padding: 64px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-mask__veil,
		.scroll-mask__image,
		.scroll-mask__tile,
		.scroll-mask__content {
			transition: none;
		}
	}
</style>

<script>
	import { initScrollMasks } from "../lib/scrollMask";
	initScrollMasks();
</script>
