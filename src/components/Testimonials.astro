---
import { testimonials } from "../data/testimonials";
---

<section class="testimonials">
	<div class="testimonials-header">
		<h2 class="testimonials-title">Better Heard in Their Own Words</h2>
		<div class="testimonials-nav">
			<button type="button" class="testimonials-nav-btn" id="testimonialPrev" aria-label="Previous testimonial">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M15 18l-6-6 6-6" />
				</svg>
			</button>
			<button type="button" class="testimonials-nav-btn" id="testimonialNext" aria-label="Next testimonial">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 18l6-6-6-6" />
				</svg>
			</button>
		</div>
	</div>

	<div class="testimonials-content">
		<div class="testimonial-featured" id="testimonialFeatured"></div>
		<div class="testimonial-list" id="testimonialList"></div>
	</div>
</section>

<style>
	.testimonials {
		display: flex;
		width: 100%;
		padding: 120px 64px 140px;
		flex-direction: column;
		gap: 56px;
	}

	.testimonials-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-bottom: 32px;
		border-bottom: 1px solid rgba(17, 24, 39, 0.12);
	}

	.testimonials-title {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 36px;
		font-weight: 400;
		letter-spacing: 4px;
		text-transform: uppercase;
	}

	.testimonials-nav {
		display: flex;
		flex-shrink: 0;
		gap: 8px;
	}

	.testimonials-nav-btn {
		display: flex;
		width: 40px;
		height: 40px;
		align-items: center;
		justify-content: center;
		border: 1px solid #111827;
		background: transparent;
		color: #111827;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	@media (hover: hover) {
		.testimonials-nav-btn:hover {
			background: #111827;
			color: #fff;
		}
	}

	.testimonials-content {
		display: grid;
		grid-template-columns: 1fr 360px;
		gap: 72px;
		align-items: start;
	}

	@media (max-width: 1024px) {
		.testimonials {
			padding: 64px 24px 80px;
			gap: 32px;
		}

		.testimonials-title {
			font-size: 26px;
			letter-spacing: 2px;
		}

		.testimonials-header {
			padding-bottom: 24px;
		}

		.testimonials-content {
			grid-template-columns: 1fr;
			gap: 40px;
		}
	}
</style>

<style is:global>
	/* Featured testimonial (left) — markup injected client-side, so these rules must be global */
	.testimonial-quote-icon {
		color: rgba(17, 24, 39, 0.15);
		font-family: "Cormorant Garamond", serif;
		font-size: 56px;
		line-height: 1;
		margin: 0 0 16px;
	}

	.testimonial-quote {
		margin: 0 0 32px;
		min-height: 150px;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 28px;
		font-weight: 400;
		line-height: 1.45;
	}

	.testimonial-author {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.testimonial-avatar {
		display: flex;
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		align-items: center;
		justify-content: center;
		background: #111827;
		color: #fff;
		font-family: "Manrope", sans-serif;
		font-size: 14px;
		font-weight: 600;
	}

	.testimonial-author-details {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.testimonial-author-name {
		margin: 0;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 15px;
		font-weight: 600;
	}

	.testimonial-author-product {
		margin: 0;
		color: #b8a68a;
		font-family: "Manrope", sans-serif;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	/* List (right) */
	.testimonial-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgba(17, 24, 39, 0.12);
	}

	.testimonial-list-item {
		display: flex;
		flex-direction: column;
		border-bottom: 1px solid rgba(17, 24, 39, 0.12);
	}

	.testimonial-list-row {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 20px 4px;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		opacity: 0.45;
		transition: opacity 0.25s ease;
	}

	.testimonial-list-row .testimonial-avatar {
		width: 40px;
		height: 40px;
		font-size: 12px;
	}

	@media (hover: hover) {
		.testimonial-list-row:hover {
			opacity: 0.75;
		}
	}

	.testimonial-list-item.active .testimonial-list-row {
		opacity: 1;
	}

	.testimonial-progress-track {
		position: relative;
		height: 1px;
		background: rgba(17, 24, 39, 0.12);
	}

	.testimonial-progress-bar {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 0%;
		background: #b8a68a;
	}

	@media (max-width: 1024px) {
		.testimonial-quote {
			font-size: 22px;
			min-height: 220px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonial-list-row,
		.testimonial-progress-bar {
			transition: none;
		}
	}
</style>

<script>
	import { testimonials } from "../data/testimonials";

	const SLIDE_DURATION = 6000;

	const featuredEl = document.getElementById("testimonialFeatured");
	const listEl = document.getElementById("testimonialList");
	const prevBtn = document.getElementById("testimonialPrev");
	const nextBtn = document.getElementById("testimonialNext");

	if (featuredEl && listEl && prevBtn && nextBtn) {
		let currentIndex = 0;
		let startTime = 0;
		let animationFrame = 0;

		function renderFeatured() {
			const item = testimonials[currentIndex];
			if (!featuredEl) return;
			featuredEl.innerHTML = `
				<p class="testimonial-quote-icon">&ldquo;</p>
				<p class="testimonial-quote">${item.text}</p>
				<div class="testimonial-author">
					<div class="testimonial-avatar">${item.initials}</div>
					<div class="testimonial-author-details">
						<p class="testimonial-author-name">${item.author}</p>
						<p class="testimonial-author-product">${item.product}</p>
					</div>
				</div>
			`;
		}

		function renderList() {
			if (!listEl) return;
			listEl.innerHTML = testimonials
				.map(
					(item, index) => `
						<div class="testimonial-list-item${index === currentIndex ? " active" : ""}" data-index="${index}">
							<button type="button" class="testimonial-list-row">
								<div class="testimonial-avatar">${item.initials}</div>
								<div class="testimonial-author-details">
									<p class="testimonial-author-name">${item.author}</p>
									<p class="testimonial-author-product">${item.product}</p>
								</div>
							</button>
							<div class="testimonial-progress-track">
								${index === currentIndex ? '<div class="testimonial-progress-bar" id="testimonialProgressBar"></div>' : ""}
							</div>
						</div>
					`,
				)
				.join("");

			listEl.querySelectorAll<HTMLElement>("[data-index]").forEach((row) => {
				row.addEventListener("click", () => {
					const index = Number(row.dataset.index);
					goTo(index);
				});
			});
		}

		function startProgress() {
			cancelAnimationFrame(animationFrame);
			startTime = performance.now();
			const bar = document.getElementById("testimonialProgressBar");
			if (!bar) return;

			function tick() {
				const elapsed = performance.now() - startTime;
				const progress = Math.min((elapsed / SLIDE_DURATION) * 100, 100);
				bar.style.width = `${progress}%`;

				if (progress >= 100) {
					goTo((currentIndex + 1) % testimonials.length);
					return;
				}
				animationFrame = requestAnimationFrame(tick);
			}
			animationFrame = requestAnimationFrame(tick);
		}

		function goTo(index: number) {
			currentIndex = index;
			renderFeatured();
			renderList();
			startProgress();
		}

		prevBtn.addEventListener("click", () => {
			goTo((currentIndex - 1 + testimonials.length) % testimonials.length);
		});
		nextBtn.addEventListener("click", () => {
			goTo((currentIndex + 1) % testimonials.length);
		});

		let touchStartX = 0;
		featuredEl.addEventListener("touchstart", (event) => {
			touchStartX = event.changedTouches[0].screenX;
		});
		featuredEl.addEventListener("touchend", (event) => {
			const touchEndX = event.changedTouches[0].screenX;
			if (touchEndX < touchStartX - 50) goTo((currentIndex + 1) % testimonials.length);
			if (touchEndX > touchStartX + 50) goTo((currentIndex - 1 + testimonials.length) % testimonials.length);
		});

		renderFeatured();
		renderList();
		startProgress();
	}
</script>
