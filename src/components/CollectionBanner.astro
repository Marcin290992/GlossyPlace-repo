---
interface Props {
	title: string;
	href: string;
	imageUrl?: string;
	imageAlt?: string;
}

const { title, href, imageUrl, imageAlt = "" } = Astro.props;
---

<section class="collection-banner">
	{
		imageUrl ? (
			<img src={imageUrl} alt={imageAlt} class="collection-banner-image" loading="lazy" />
		) : (
			<div class="collection-banner-image collection-banner-placeholder" />
		)
	}
	<div class="collection-banner-card">
		<p class="collection-banner-title">{title}</p>
		<a href={href} class="collection-banner-link">Shop the Collection</a>
	</div>
</section>

<style>
	.collection-banner {
		position: relative;
		width: 100%;
		height: 400px;
		overflow: hidden;
	}

	@media (min-width: 1025px) {
		.collection-banner {
			height: 500px;
		}
	}

	.collection-banner-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
	}

	.collection-banner-placeholder {
		background: #f4f0ea;
	}

	.collection-banner-card {
		position: absolute;
		left: 24px;
		bottom: 24px;
		max-width: min(440px, calc(100% - 48px));
		padding: 20px 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		text-align: center;
		background: rgba(255, 255, 255, 0.6);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.collection-banner-title {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-weight: 400;
		font-size: 28px;
		line-height: 1.1;
		letter-spacing: -0.5px;
	}

	@media (min-width: 1025px) {
		.collection-banner-title {
			font-size: 48px;
		}
	}

	.collection-banner-link {
		margin: 0;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-weight: 600;
		font-size: 11px;
		letter-spacing: 2.5px;
		text-transform: uppercase;
		text-decoration: underline;
	}

	.collection-banner-link:hover,
	.collection-banner-link:focus-visible {
		opacity: 0.7;
	}
</style>
