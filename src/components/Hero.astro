---
import { Image } from "astro:assets";
import heroDesktop from "../images/hero-desktop.webp";
import heroDesktop2 from "../images/hero-desktop-2.webp";
import heroDesktop3 from "../images/hero-desktop-3.webp";

const slides = [
	{ src: heroDesktop, position: "center 75%" },
	{ src: heroDesktop2, position: "center 75%" },
	{ src: heroDesktop3, position: "center 85%" },
];
const cycleSeconds = 12;
---

<section class="hero">
	{
		slides.map((slide, index) => (
			<Image
				src={slide.src}
				alt="Glossy Place"
				class="hero-image"
				style={`animation-delay: ${(-index * cycleSeconds) / slides.length}s; object-position: ${slide.position};`}
				loading={index === 0 ? "eager" : "lazy"}
			/>
		))
	}
</section>

<style define:vars={{ cycleSeconds }}>
	.hero {
		position: relative;
		display: flex;
		height: 630px;
		flex-direction: column;
		align-items: flex-start;
		flex-shrink: 0;
		align-self: stretch;
		overflow: hidden;
	}

	@media (min-width: 1025px) {
		.hero {
			height: calc(100vh - 111px);
		}
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		animation: hero-crossfade calc(var(--cycleSeconds) * 1s) ease-in-out infinite;
	}

	.hero-image:first-child {
		opacity: 1;
	}

	@keyframes hero-crossfade {
		0%,
		29% {
			opacity: 1;
		}
		33%,
		96% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-image {
			animation: none;
			opacity: 0;
		}

		.hero-image:first-child {
			opacity: 1;
		}
	}

</style>
