---
import { Image } from "astro:assets";
import heroDesktop from "../images/hero-desktop.webp";
import heroDesktop2 from "../images/hero-desktop-2.webp";
import heroDesktop3 from "../images/hero-desktop-3.webp";

const slides = [
	{ src: heroDesktop, position: "58% 75%" },
	{ src: heroDesktop2, position: "58% 85%" },
	{ src: heroDesktop3, position: "58% 85%" },
];
const cycleSeconds = 12;
---

<section class="hero">
	{
		slides.map((slide, index) => (
			<Image
				src={slide.src}
				alt="Glossy Place"
				class="hero-image"
				style={`animation-delay: ${(-index * cycleSeconds) / slides.length}s; object-position: ${slide.position};`}
				loading={index === 0 ? "eager" : "lazy"}
			/>
		))
	}
	<div class="hero-scrim"></div>
	<div class="hero-content">
		<h1 class="hero-title">Choose your energy and find your talisman</h1>
		<p class="hero-subtitle">Handmade gemstone bracelets, created with meaning, intention and positive energy.</p>
		<a href="/shop" class="hero-cta">Shop the Collection</a>
	</div>
</section>

<style define:vars={{ cycleSeconds }}>
	.hero {
		position: relative;
		display: flex;
		height: 630px;
		flex-direction: column;
		align-items: flex-start;
		flex-shrink: 0;
		align-self: stretch;
		overflow: hidden;
	}

	@media (min-width: 1025px) {
		.hero {
			height: calc(100vh - 111px);
		}
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		animation: hero-crossfade calc(var(--cycleSeconds) * 1s) ease-in-out infinite;
	}

	.hero-image:first-child {
		opacity: 1;
	}

	@keyframes hero-crossfade {
		0%,
		29% {
			opacity: 1;
		}
		33%,
		96% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-image {
			animation: none;
			opacity: 0;
		}

		.hero-image:first-child {
			opacity: 1;
		}
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(17, 24, 39, 0.65) 0%, rgba(17, 24, 39, 0.2) 45%, transparent 75%);
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		max-width: 560px;
		margin-top: auto;
		padding: 0 24px 56px;
		animation: hero-content-in 0.8s ease-out both;
		animation-delay: 0.2s;
	}

	@media (min-width: 1025px) {
		.hero-content {
			padding: 0 64px 80px;
		}
	}

	.hero-title {
		margin: 0;
		color: #fff;
		font-family: "Cormorant Garamond", serif;
		font-size: 44px;
		font-weight: 400;
		line-height: 1.1;
	}

	@media (min-width: 1025px) {
		.hero-title {
			font-size: 64px;
		}
	}

	.hero-subtitle {
		margin: 0;
		color: rgba(255, 255, 255, 0.85);
		font-family: "Manrope", sans-serif;
		font-size: 15px;
		line-height: 1.6;
	}

	.hero-cta {
		margin-top: 8px;
		padding: 16px 36px;
		background: #fff;
		color: #111827;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	@media (hover: hover) {
		.hero-cta:hover {
			opacity: 0.85;
		}
	}

	@keyframes hero-content-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-content {
			animation: none;
		}
	}

	@media (max-width: 640px) {
		.hero-title {
			font-size: 34px;
		}

		.hero-subtitle {
			font-size: 14px;
		}
	}

</style>
