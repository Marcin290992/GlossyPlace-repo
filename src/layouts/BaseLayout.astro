---
import "../styles/global.css";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import cormorantRegular from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url";
import manropeRegular from "@fontsource/manrope/files/manrope-latin-400-normal.woff2?url";
import manropeSemibold from "@fontsource/manrope/files/manrope-latin-600-normal.woff2?url";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Preload the most-used font weights so they're in place before
		     first paint, instead of flashing a fallback font first. -->
		<link rel="preload" href={cormorantRegular} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={manropeRegular} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={manropeSemibold} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<AnnouncementBar />
		<Header />
		<slot />
		<Footer />
		<CartDrawer />
	</body>
</html>
