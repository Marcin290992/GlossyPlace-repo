---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProductGrid from "../components/ProductGrid.astro";
import CollectionBanner from "../components/CollectionBanner.astro";
import ShopByCategory from "../components/ShopByCategory.astro";
import MoreToExplore from "../components/MoreToExplore.astro";
import AtYourService from "../components/AtYourService.astro";
import Newsletter from "../components/Newsletter.astro";
import { womensImageUrl } from "../data/collectionImages";
---

<BaseLayout title="Glossy Place">
	<Hero />
	<ProductGrid title="Find Your Ritual" collection="our-collections" />
	<CollectionBanner
		title="Women's Collection"
		href="/shop"
		imageUrl={womensImageUrl}
		imageAlt="Woman relaxing in silk loungewear wearing a Glossy Place bracelet"
	/>
	<ShopByCategory />
	<CollectionBanner title="Men's Collection" href="/shop" />
	<ProductGrid title="Discover Collection" collection="discover-collection" />
	<CollectionBanner title="Kids' Collection" href="/shop" />
	<MoreToExplore />
	<AtYourService />
	<Newsletter />
</BaseLayout>
