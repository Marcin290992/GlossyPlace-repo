---
import BaseLayout from "../layouts/BaseLayout.astro";
import JournalCard from "../components/JournalCard.astro";
import { sanityClient } from "sanity:client";

type PostSummary = {
	title: string;
	slug: string;
	excerpt: string;
	coverImage: unknown;
	publishedAt: string;
};

const posts = await sanityClient.fetch<PostSummary[]>(
	`*[_type == "post" && defined(slug.current)] | order(publishedAt desc){
		title,
		"slug": slug.current,
		excerpt,
		coverImage,
		publishedAt
	}`
);
---

<BaseLayout title="Journal — Glossy Place">
	<main class="journal">
		<section class="journal-intro">
			<p class="journal-eyebrow">Journal</p>
			<h1 class="journal-title">Stories, Rituals & Gemstone Wisdom</h1>
			<p class="journal-lead">Notes on meaning, making, and the stones behind every Glossyplace piece.</p>
		</section>

		{
			posts.length === 0 ? (
				<p class="journal-empty">New stories are on their way — check back soon.</p>
			) : (
				<ul class="journal-grid">
					{posts.map((post) => <JournalCard {...post} />)}
				</ul>
			)
		}
	</main>
</BaseLayout>

<style>
	.journal {
		background: #fff;
	}

	.journal-intro {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 720px;
		padding: 64px 24px 40px;
		margin: 0 auto;
		text-align: center;
	}

	@media (min-width: 640px) {
		.journal-intro {
			padding: 80px 24px 56px;
		}
	}

	.journal-eyebrow {
		margin: 0;
		color: #b8a68a;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.journal-title {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 36px;
		font-weight: 400;
	}

	@media (min-width: 640px) {
		.journal-title {
			font-size: 42px;
		}
	}

	.journal-lead {
		margin: 0;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 15px;
		line-height: 1.7;
	}

	.journal-empty {
		max-width: 480px;
		margin: 0 auto;
		padding: 40px 24px 120px;
		text-align: center;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 15px;
	}

	.journal-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px 100px;
		list-style: none;
	}

	@media (min-width: 640px) {
		.journal-grid {
			grid-template-columns: repeat(2, 1fr);
			padding: 0 40px 120px;
		}
	}

	@media (min-width: 1025px) {
		.journal-grid {
			grid-template-columns: repeat(3, 1fr);
			padding: 0 64px 140px;
		}
	}
</style>
