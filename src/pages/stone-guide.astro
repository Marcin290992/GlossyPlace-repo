---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { stones } from "../data/stones";

const placeholderImages = [
	"/images/about/placeholder-craft.svg",
	"/images/about/placeholder-lifestyle.svg",
	"/images/about/placeholder-detail.svg",
];

// Real client photos, keyed by exact filename in that folder. A handful of
// filenames don't match the stone name 1:1 (typos, "jadeite" vs "jade",
// missing apostrophes) — mapped explicitly below rather than guessed at
// runtime. Stones with no entry here (or no matching file) fall back to a
// placeholder until a real photo is supplied.
const stonePhotoFiles = import.meta.glob<{ default: ImageMetadata }>("../images/Kamienie Webfile/*.webp", {
	eager: true,
});

function getStonePhoto(filename: string) {
	return stonePhotoFiles[`../images/Kamienie Webfile/${filename}`]?.default;
}

const stonePhotoFilenames: Record<string, string> = {
	"African Turquoise": "African Turquoise.webp",
	Amazonite: "Amazonite.webp",
	Amethyst: "Amethyst.webp",
	Apatite: "Apatite.webp",
	Aquamarine: "Aquamarine.webp",
	Aventurine: "Green Aventurine.webp",
	"Baltic Amber": "Baltic Amber.webp",
	"Black Onyx": "Black Onyx.webp",
	"Black Tourmaline": "Black tourmaline.webp",
	"Blue Agate": "Blue Agate.webp",
	"Blue Sandstone": "Blue Sandstone.webp",
	"Blue Tiger's Eye": "Blue Tiger Eye.webp",
	Bronzite: "Bronzite.webp",
	"Burma Jade": "Burma jadeite.webp",
	Carnelian: "Carnelian.webp",
	Citrine: "Citrine.webp",
	"Clear Quartz": "Clear quartz.webp",
	"Dalmatian Stone": "Dalmatian Stone.webp",
	Garnet: "Garnet.webp",
	Howlite: "Howlite.webp",
	"Indian Agate": "Indian agat.webp",
	Jade: "Green jadeite.webp",
	Jasper: "Jasper.webp",
	Kunzite: "Kunzite.webp",
	"Lapis Lazuli": "Lapis Lazuli.webp",
	Larimar: "Larimar.webp",
	"Lava Stone": "Lava Stone.webp",
	Magnesite: "Magnesite.webp",
	"Mahogany Obsidian": "Mahogany Obsidian.webp",
	Malachite: "Malachite.webp",
	Moonstone: "Moonstone.webp",
	Mookaite: "Mookaite.webp",
	Morganite: "Morganite.webp",
	"Moss Agate": "Moss Agate.webp",
	"Mother of Pearl": "Mother of Pearl.webp",
	Olivine: "Olivine.webp",
	Opalite: "Opalite.webp",
	Pearl: "Pearl.webp",
	Peridot: "Peridot.webp",
	"Picture Jasper": "Picture Jasper.webp",
	"Pink Jade": "Pink jadeite.webp",
	"Pink Tourmaline": "Pink turmalin.webp",
	"Red Agate": "Red Agate.webp",
	"Red Sandstone": "Red sandstone.webp",
	Rhodonite: "Rhodonite.webp",
	"River Stone": "River stone.webp",
	"Rose Quartz": "Rose Quartz.webp",
	Ruby: "Ruby.webp",
	Sapphire: "Sapphire.webp",
	"Smoky Quartz": "Smoky quartz.webp",
	Sunstone: "Sunstone.webp",
	"Tiger's Eye": "Tiger’s Eye.webp",
	Turquoise: "Turquoise.webp",
	"White Coral": "White coral.webp",
	"White Jade": "White Jade.webp",
	"White Porcelain Jade": "White Porcelain Jade.webp",
	"White Turquoise": "White turquise.webp",
	"Yellow Calcite": "Yellow Calcite.webp",
	"Yellow Jade": "Yellow Jadeite.webp",
	Zircon: "Zircon.webp",
};

type ListEntry = { type: "marker"; letter: string } | { type: "item"; index: number; name: string; symbol: string; meaning: string[] };

const listEntries: ListEntry[] = [];
const seenLetters = new Set<string>();

stones.forEach((stone, index) => {
	const letter = stone.name[0]?.toUpperCase() ?? "";
	if (!seenLetters.has(letter)) {
		seenLetters.add(letter);
		listEntries.push({ type: "marker", letter });
	}
	listEntries.push({ type: "item", index, name: stone.name, symbol: stone.symbol, meaning: stone.meaning });
});

const availableLetters = [...seenLetters];

const stoneData = await Promise.all(
	stones.map(async (stone, index) => {
		const filename = stonePhotoFilenames[stone.name];
		const photo = filename ? getStonePhoto(filename) : undefined;
		const image = photo
			? (await getImage({ src: photo, width: 1200 })).src
			: placeholderImages[index % placeholderImages.length];
		return { ...stone, image };
	})
);
---

<BaseLayout title="Gemstone Guide — Glossy Place">
	<main class="guide">
		<div class="guide-layout">
			<div class="guide-sidebar">
				<div class="guide-sticky-header">
					<section class="guide-intro">
						<p class="guide-eyebrow">Gemstone Guide</p>
						<h1 class="guide-title">The Meaning Behind Every Stone</h1>
						<p class="guide-lead">
							Discover the traditional meaning and energy behind each gemstone used in Glossyplace jewellery. Tap any
							stone to see it up close.
						</p>
					</section>

					<nav class="guide-az-nav" aria-label="Jump to letter">
						{
							availableLetters.map((letter) => (
								<a href={`#guide-letter-${letter}`} class="guide-az-link">
									{letter}
								</a>
							))
						}
					</nav>
				</div>

				<div class="guide-preview-pane">
					<div class="guide-preview-wrapper" id="guide-preview"></div>
					<span class="guide-active-indicator" id="guide-active-indicator" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9 6l6 6-6 6" />
						</svg>
					</span>
				</div>
			</div>

			<ul class="guide-list" id="guide-list">
				{
					listEntries.map((entry) =>
						entry.type === "marker" ? (
							<li class="guide-letter-marker" id={`guide-letter-${entry.letter}`} aria-hidden="true">
								{entry.letter}
							</li>
						) : (
							<li>
								<button
									type="button"
									class={`guide-item${entry.index === 0 ? " active" : ""}`}
									data-index={entry.index}
								>
									<span class="guide-item-name">{entry.name}</span>
									<span class="guide-item-desc">{entry.symbol}</span>
									<span class="guide-item-tags">
										{entry.meaning.map((tag) => (
											<span class="guide-tag">{tag}</span>
										))}
									</span>
								</button>
							</li>
						)
					)
				}
			</ul>
		</div>

		<section class="guide-closing">
			<p class="guide-closing-word">Glossyplace</p>
			<p class="guide-closing-tagline">Jewellery with Positive Energy</p>
			<a href="/shop" class="guide-closing-cta">Shop the Collection</a>
		</section>
	</main>

	<button type="button" id="guide-back-to-top" class="guide-back-to-top" aria-label="Back to top">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 19V5M5 12l7-7 7 7" />
		</svg>
		Back to Top
	</button>

	<div id="guide-modal-backdrop" class="guide-modal-backdrop"></div>
	<div id="guide-modal" class="guide-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="guide-modal-name">
		<button type="button" id="guide-modal-close" class="guide-modal-close" aria-label="Close">✕</button>
		<div class="guide-modal-image" id="guide-modal-image"></div>
		<div class="guide-modal-body">
			<p class="guide-modal-name" id="guide-modal-name"></p>
			<p class="guide-modal-symbol" id="guide-modal-symbol"></p>
			<div class="guide-modal-tags" id="guide-modal-tags"></div>
		</div>
	</div>

	<div id="guide-stone-data" data-stones={JSON.stringify(stoneData)} hidden></div>
</BaseLayout>

<style>
	.guide {
		background: #fff;
	}

	.guide-intro {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 720px;
		padding: 64px 64px 0;
	}

	.guide-eyebrow {
		margin: 0;
		color: #b8a68a;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 3px;
		text-transform: uppercase;
	}

	.guide-title {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 42px;
		font-weight: 400;
		letter-spacing: 1px;
	}

	.guide-lead {
		margin: 0;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 15px;
		line-height: 1.7;
	}

	.guide-sidebar {
		position: sticky;
		top: 111px;
		z-index: 2;
		display: flex;
		width: 40%;
		height: calc(100vh - 111px);
		flex-direction: column;
	}

	.guide-sticky-header {
		flex-shrink: 0;
		background: #fff;
	}

	.guide-az-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 32px 64px;
		border-bottom: 1px solid #e5e7eb;
	}

	.guide-az-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		text-decoration: none;
	}

	@media (hover: hover) {
		.guide-az-link:hover {
			color: #111827;
		}
	}

	.guide-layout {
		display: flex;
		align-items: flex-start;
	}

	.guide-preview-pane {
		flex: 1;
		min-height: 0;
		width: 100%;
		padding: 40px 24px 40px 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		/* Opaque so the padding around the image isn't a transparent gap
		   the scrolling list can show through — only the wrapper had a
		   background before, leaving this box's own padding see-through. */
		background: #fff;
	}

	.guide-preview-wrapper {
		position: relative;
		/* width:auto + aspect-ratio only works like an <img>'s "shrink to
		   fit" when the element has real intrinsic content to size from —
		   this is an empty div whose only children are position:absolute
		   (so they don't count), which collapses it to 0×0. Compute the
		   width directly from the pane's actual measured height instead
		   (see script) so it holds a true 4:3 ratio without ever exceeding
		   either the column width or the pane's available height. */
		width: min(100%, calc(var(--guide-pane-height, 400px) * 4 / 3));
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #f4f0ea;
	}

	.guide-list {
		margin: 0;
		width: 60%;
		list-style: none;
		/* Bottom padding must be at least the sticky sidebar's own height
		   — otherwise, near the end of the list, the sidebar runs out of
		   room in its containing block and gets pushed off-screen before
		   the last few stones (and jumps to late letters like W/Y) can
		   show it in full. */
		padding: 8px 64px calc(100vh - 111px) 24px;
	}

	.guide-closing {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 20px;
		padding: 180px 24px;
		text-align: center;
	}

	.guide-closing-word {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 48px;
		font-weight: 400;
		letter-spacing: 6px;
		text-transform: uppercase;
	}

	.guide-closing-tagline {
		margin: 0 0 12px;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.guide-closing-cta {
		padding: 16px 40px;
		border: 1px solid #111827;
		background: #111827;
		color: #fff;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	@media (hover: hover) {
		.guide-closing-cta:hover {
			background: #fff;
			color: #111827;
		}
	}

	.guide-letter-marker {
		padding: 28px 10px 8px;
		margin: 0 -10px;
		color: #b8a68a;
		font-family: "Cormorant Garamond", serif;
		font-size: 28px;
		font-weight: 400;
		letter-spacing: 1px;
		text-transform: uppercase;
		scroll-margin-top: 135px;
		transition: background-color 0.4s ease;
	}

	/* Briefly highlights the letter a jump landed on, so it's obvious
	   where the A-Z nav actually took you. */
	.guide-letter-marker.flash {
		background: #f4f0ea;
	}

	.guide-item {
		display: flex;
		align-items: center;
		gap: 24px;
		width: 100%;
		padding: 14px 0;
		border: none;
		border-bottom: 1px solid #e5e7eb;
		background: none;
		cursor: pointer;
		text-align: left;
		transition:
			opacity 0.3s ease,
			padding-left 0.3s ease,
			border-color 0.3s ease;
	}

	.guide-active-indicator {
		display: none;
	}

	.guide-back-to-top {
		display: none;
	}

	.guide-item-name {
		flex: 1;
		min-width: 160px;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 20px;
		font-weight: 400;
	}

	.guide-item-desc {
		flex: 1;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 13px;
	}

	.guide-item-tags {
		display: flex;
		flex: 1.4;
		flex-wrap: wrap;
		gap: 8px;
	}


	@media (min-width: 901px) {
		.guide-list:hover .guide-item {
			opacity: 0.35;
		}

		.guide-list .guide-item:hover {
			opacity: 1;
			padding-left: 12px;
			border-color: #111827;
		}

		.guide-az-link {
			width: 34px;
			height: 34px;
			color: #b8a68a;
			font-size: 14px;
		}
	}

	@media (max-width: 900px) {
		/* The sidebar wrapper only exists to give desktop a single sticky
		   left column (header + photo stacked together). On mobile it
		   needs to disappear from the box model entirely so its two
		   children fall back to being plain stacked items in
		   .guide-layout's column flow, each keeping its own existing
		   mobile behaviour below. */
		.guide-sidebar {
			display: contents;
		}

		.guide-sticky-header {
			position: static;
		}

		.guide-intro {
			padding: 100px 24px 0;
		}

		.guide-title {
			font-size: 30px;
		}

		.guide-az-nav {
			padding: 24px;
		}

		.guide-layout {
			flex-direction: column;
		}

		.guide-preview-pane {
			position: sticky;
			top: 111px;
			z-index: 2;
			width: 100%;
			height: 45vh;
			padding: 16px 24px;
		}

		.guide-preview-wrapper {
			width: 100%;
			height: 100%;
			aspect-ratio: auto;
		}

		.guide-letter-marker {
			/* The pinned preview image covers the top 45vh on mobile, so a jump
			   target needs to land below it, not just below the site header. */
			scroll-margin-top: calc(45vh + 111px + 16px);
		}

		.guide-list {
			width: 100%;
			padding: 8px 24px 45vh 48px;
		}

		.guide-closing {
			padding: 120px 24px;
		}

		.guide-closing-word {
			font-size: 34px;
			letter-spacing: 4px;
		}

		.guide-item {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
			opacity: 0.4;
			position: relative;
			padding: 20px 16px;
			margin: 0 -16px;
			background: transparent;
			transition:
				opacity 0.3s ease,
				background-color 0.3s ease,
				border-color 0.3s ease;
		}

		.guide-item.active {
			opacity: 1;
			background: #f4f0ea;
			border-color: transparent;
		}

		/* A single indicator attached to the pinned photo itself (not one
		   per row) rather than fixed to the viewport — as a child of the
		   sticky pane it inherits the exact same sticky behaviour, so it
		   sits right below the photo whether the pane is stuck or still
		   in normal flow, and is simply always there, no show/hide logic
		   needed.

		   Its vertical offset is solved so that, once the pane is stuck
		   (top: 111px, height: 45vh), the indicator's center lands exactly
		   on the viewport's 65%-down line — the same "top 65%" threshold
		   the ScrollTrigger below uses to decide which stone is active.
		   That's what makes the arrow actually point at the row that's
		   really about to activate, instead of an unrelated fixed spot.
		   bottom = -(65vh − (111px + 45vh) + half the icon's height)
		          = -(20vh − 111px + 14px) = calc(97px - 20vh) */
		.guide-active-indicator {
			display: flex;
			position: absolute;
			left: 0;
			bottom: calc(97px - 20vh);
			z-index: 5;
			align-items: center;
			justify-content: center;
			color: #b8a68a;
		}

		.guide-back-to-top {
			display: flex;
			position: fixed;
			right: 16px;
			bottom: 16px;
			z-index: 10;
			align-items: center;
			gap: 6px;
			padding: 10px 16px;
			border: none;
			border-radius: 999px;
			background: #111827;
			color: #fff;
			font-family: "Manrope", sans-serif;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 1px;
			text-transform: uppercase;
			box-shadow: 0 4px 16px rgba(17, 24, 39, 0.25);
			opacity: 0;
			pointer-events: none;
			transform: translateY(8px);
			transition:
				opacity 0.25s ease,
				transform 0.25s ease;
		}

		.guide-back-to-top.visible {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}
	}
</style>

<style is:global>
	.guide-preview-wrapper img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		will-change: transform, clip-path;
	}

	.guide-modal-backdrop {
		position: fixed;
		inset: 0;
		z-index: 900;
		background: rgba(17, 24, 39, 0.5);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.guide-modal-backdrop.open {
		opacity: 1;
		pointer-events: auto;
	}

	.guide-modal {
		position: fixed;
		top: 50%;
		left: 50%;
		z-index: 901;
		width: calc(100% - 48px);
		max-width: 480px;
		max-height: 85vh;
		overflow-y: auto;
		background: #fff;
		transform: translate(-50%, -50%) scale(0.96);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.guide-modal.open {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
		pointer-events: auto;
	}

	.guide-modal-close {
		position: absolute;
		top: 16px;
		right: 16px;
		z-index: 1;
		width: 32px;
		height: 32px;
		border: none;
		border-radius: 50%;
		background: #111827;
		color: #fff;
		font-size: 14px;
		cursor: pointer;
	}

	.guide-modal-image {
		width: 100%;
		aspect-ratio: 4 / 3;
		background: #f4f0ea;
	}

	.guide-modal-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.guide-modal-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		padding: 32px 28px 36px;
		text-align: center;
	}

	.guide-modal-name {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 30px;
		font-weight: 400;
	}

	.guide-modal-symbol {
		margin: 0;
		color: #b8a68a;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.guide-modal-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin-top: 4px;
	}

	/* Base pill styling for .guide-tag lives here (global), not in the
	   scoped <style> block above — the modal's tags are built client-side
	   via innerHTML, so they never receive Astro's scoping attribute and
	   a scoped rule would silently never match them (same class of bug
	   as Testimonials/CartDrawer elsewhere in this project). The list's
	   own server-rendered tags match this fine too, since global rules
	   don't care about scope either way. */
	.guide-tag {
		padding: 4px 10px;
		border: 1px solid #e5e7eb;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 10px;
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}

	.guide-modal-tags .guide-tag {
		font-size: 11px;
	}

</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	// The preview wrapper's width is computed from this pane's real
	// rendered height (see the CSS) — it's the remaining space in the
	// sidebar after the intro/A-Z header, which flexbox already sizes
	// correctly but which no static CSS formula can express on its own.
	const previewPane = document.querySelector<HTMLElement>(".guide-preview-pane");
	if (previewPane) {
		const syncPaneHeight = () => {
			// clientHeight includes the pane's own top/bottom padding —
			// subtract it so the var reflects the actual content area the
			// photo has to fit in, not the pane's full box height.
			const style = getComputedStyle(previewPane);
			const available =
				previewPane.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
			document.documentElement.style.setProperty("--guide-pane-height", `${available}px`);
		};
		syncPaneHeight();
		new ResizeObserver(syncPaneHeight).observe(previewPane);
	}

	type StoneRecord = { name: string; symbol: string; meaning: string[]; image: string };

	const dataEl = document.getElementById("guide-stone-data");
	const stoneData: StoneRecord[] = dataEl ? JSON.parse(dataEl.dataset.stones || "[]") : [];

	const previewContainer = document.getElementById("guide-preview");
	const items = document.querySelectorAll<HTMLButtonElement>(".guide-item");

	const images: HTMLImageElement[] = [];
	let currentIndex = -1;

	if (previewContainer) {
		stoneData.forEach((stone) => {
			const img = document.createElement("img");
			img.src = stone.image;
			img.alt = "";
			previewContainer.appendChild(img);
			images.push(img);
		});

		if (images[0]) {
			// Full opacity, not a dimmed "ambient" state — showImage() never
			// runs for index 0 since currentIndex already starts there, so
			// whatever this is set to is what the first stone's photo looks
			// like until the user actually swaps to a different one.
			gsap.set(images[0], { clipPath: "inset(0% 0% 0% 0%)", scale: 1, opacity: 1 });
			currentIndex = 0;
		}
	}

	function showImage(index: number) {
		const nextImg = images[index];
		if (!nextImg || index === currentIndex) return;

		const prevImg = currentIndex !== -1 ? images[currentIndex] : null;
		const direction = currentIndex === -1 || index > currentIndex ? 1 : -1;

		// Fast hovering across many rows can queue up several tweens on the
		// same image faster than they finish — kill anything in flight so a
		// stale tween never leaves an image stuck mid-transition.
		gsap.killTweensOf(nextImg);
		if (prevImg) gsap.killTweensOf(prevImg);

		gsap.set(nextImg, { zIndex: 2 });
		if (prevImg) gsap.set(prevImg, { zIndex: 1 });

		const startClip = direction === 1 ? "inset(100% 0% 0% 0%)" : "inset(0% 0% 100% 0%)";

		gsap.fromTo(
			nextImg,
			{ clipPath: startClip, scale: 1.08, opacity: 1 },
			{ clipPath: "inset(0% 0% 0% 0%)", scale: 1, duration: 0.6, ease: "power3.out", overwrite: "auto" }
		);

		if (prevImg && prevImg !== nextImg) {
			gsap.to(prevImg, {
				scale: 0.97,
				opacity: 0,
				duration: 0.6,
				ease: "power3.out",
				overwrite: "auto",
			});
		}

		currentIndex = index;
	}

	const mm = gsap.matchMedia();

	mm.add("(min-width: 901px)", () => {
		items.forEach((item) => item.classList.remove("active"));

		const listeners: Array<() => void> = [];
		items.forEach((item) => {
			const index = Number(item.dataset.index);
			let hoverTimer: number | undefined;

			// Require a brief dwell before swapping — otherwise the image
			// changes on every row the cursor merely passes over while
			// scanning the list, which reads as flicker rather than a
			// deliberate hover choice.
			const onEnter = () => {
				window.clearTimeout(hoverTimer);
				hoverTimer = window.setTimeout(() => showImage(index), 200);
			};
			const onLeave = () => window.clearTimeout(hoverTimer);

			item.addEventListener("mouseenter", onEnter);
			item.addEventListener("mouseleave", onLeave);
			listeners.push(() => {
				item.removeEventListener("mouseenter", onEnter);
				item.removeEventListener("mouseleave", onLeave);
				window.clearTimeout(hoverTimer);
			});
		});

		return () => listeners.forEach((cleanup) => cleanup());
	});

	mm.add("(max-width: 900px)", () => {
		// The first stone already ships marked active in the server-rendered
		// markup (see the template), so there's no gap where it can flash
		// unstyled before this script has even finished loading GSAP.

		let settleTimer: number | undefined;

		// A fast scroll flick crosses several rows' trigger lines in quick
		// succession — same problem as the desktop hover flicker. Only
		// swap the image once the scroll position has settled on a row
		// for a moment, instead of on every row it merely passed through.
		function scheduleActivate(index: number, item: HTMLButtonElement) {
			window.clearTimeout(settleTimer);
			settleTimer = window.setTimeout(() => activate(index, item), 450);
		}

		const triggers = Array.from(items).map((item) => {
			const index = Number(item.dataset.index);
			return ScrollTrigger.create({
				trigger: item,
				start: "top 65%",
				end: "bottom 65%",
				onEnter: () => scheduleActivate(index, item),
				onEnterBack: () => scheduleActivate(index, item),
			});
		});

		function activate(index: number, item: HTMLButtonElement) {
			showImage(index);
			items.forEach((el) => el.classList.remove("active"));
			item.classList.add("active");
		}

		return () => {
			triggers.forEach((trigger) => trigger.kill());
			window.clearTimeout(settleTimer);
		};
	});

	// --- Modal ---
	const modal = document.getElementById("guide-modal");
	const modalBackdrop = document.getElementById("guide-modal-backdrop");
	const modalClose = document.getElementById("guide-modal-close");
	const modalImage = document.getElementById("guide-modal-image");
	const modalName = document.getElementById("guide-modal-name");
	const modalSymbol = document.getElementById("guide-modal-symbol");
	const modalTags = document.getElementById("guide-modal-tags");

	function openModal(index: number) {
		const stone = stoneData[index];
		if (!stone || !modal || !modalBackdrop || !modalImage || !modalName || !modalSymbol || !modalTags) return;

		modalImage.innerHTML = `<img src="${stone.image}" alt="${stone.name}">`;
		modalName.textContent = stone.name;
		modalSymbol.textContent = stone.symbol;
		modalTags.innerHTML = stone.meaning.map((tag) => `<span class="guide-tag">${tag}</span>`).join("");

		modal.classList.add("open");
		modalBackdrop.classList.add("open");
		modal.setAttribute("aria-hidden", "false");
		document.body.classList.add("no-scroll");
	}

	function closeModal() {
		modal?.classList.remove("open");
		modalBackdrop?.classList.remove("open");
		modal?.setAttribute("aria-hidden", "true");
		document.body.classList.remove("no-scroll");
	}

	items.forEach((item) => {
		item.addEventListener("click", () => openModal(Number(item.dataset.index)));
	});

	modalClose?.addEventListener("click", closeModal);
	modalBackdrop?.addEventListener("click", closeModal);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeModal();
	});

	// --- Back to top (mobile only, CSS handles hiding it on desktop) ---
	const backToTop = document.getElementById("guide-back-to-top");
	if (backToTop) {
		const toggleBackToTop = () => {
			backToTop.classList.toggle("visible", window.scrollY > 400);
		};
		window.addEventListener("scroll", toggleBackToTop, { passive: true });
		toggleBackToTop();

		backToTop.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
	}

	// --- A-Z nav: briefly flash the letter a jump landed on ---
	document.querySelectorAll<HTMLAnchorElement>(".guide-az-link").forEach((link) => {
		link.addEventListener("click", () => {
			const targetId = link.getAttribute("href")?.slice(1);
			const target = targetId ? document.getElementById(targetId) : null;
			if (!target) return;
			target.classList.add("flash");
			window.setTimeout(() => target.classList.remove("flash"), 1200);
		});
	});
</script>
