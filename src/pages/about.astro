---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollMaskSection from "../components/ScrollMaskSection.astro";
import ownerPhoto from "../images/about/Owner_glossyplace.webp";
import monikaPhoto from "../images/about/Monika_photo.webp";
import "lenis/dist/lenis.css";

const ownerImage = await getImage({ src: ownerPhoto, width: 1600 });
const monikaImage = await getImage({ src: monikaPhoto, width: 1600 });
---

<BaseLayout title="My Story — Glossy Place">
	<main class="about">
		<ScrollMaskSection
			variant="iris"
			src={ownerImage.src}
			alt="Founder of Glossyplace wearing a handmade gemstone necklace and bracelet"
			originX={50}
			originY={38}
			feather={16}
			overlay={0.55}
			scrimStyle="bottom"
			contentAlign="bottom"
			zoom={1.02}
			ratio="4 / 5"
			maxWidth={640}
			scrollLength={1.15}
			introFadeTo={0.32}
			contentFrom={0.72}
			contentTo={0.97}
		>
			<div slot="intro" class="about-intro-content">
				<p class="about-eyebrow">My Story</p>
				<p class="about-lead">
					Glossyplace was born from my love for natural beauty, timeless elegance and the unique character of
					natural gemstones.
				</p>
			</div>
			<p class="reveal-quote reveal-quote-compact">
				I have always believed that jewellery can be more than something beautiful we wear. It can carry meaning. It
				can reflect how we feel, what we need and what we want to bring into our lives. That belief became the heart
				of Glossyplace.
			</p>
		</ScrollMaskSection>

		<section class="about-text-section">
			<div class="about-text-inner">
				<p class="about-paragraph">
					I create each piece by hand, carefully choosing gemstones not only for their beauty, but also for their
					symbolism and the energy traditionally associated with them. Every combination has its own character and
					intention – from balance and confidence to protection, love or positive energy.
				</p>
			</div>
		</section>

		<ScrollMaskSection
			variant="type"
			word="TALISMAN"
			src="https://images.unsplash.com/photo-1523252012848-c22188792c27?fm=jpg&q=80&w=1600&auto=format&fit=crop"
			overlay={0.15}
			fit="cover"
		>
			<p class="reveal-quote">
				For me, a bracelet is not simply an accessory.<br />It is a personal talisman.
			</p>
		</ScrollMaskSection>

		<ScrollMaskSection
			variant="wipe"
			src="https://images.unsplash.com/photo-1668365179846-3333fe14f552?fm=jpg&q=80&w=1600&auto=format&fit=crop"
			angle={115}
			feather={16}
			overlay={0.15}
			fit="cover"
			introFadeTo={0.3}
		>
			<div slot="intro" class="about-intro-content">
				<p class="about-paragraph">
					Glossyplace is where elegance meets nature, meaning and emotion. My aim is to create jewellery that makes
					you feel special, confident and beautifully yourself – pieces you can wear every day while knowing there
					is a story behind every stone.
				</p>
			</div>
			<p class="reveal-quote">
				Something you choose because it speaks to you. Something that can remind you of your strength, your
				intention and the person you want to be.
			</p>
		</ScrollMaskSection>

		<ScrollMaskSection
			variant="curtain"
			src={monikaImage.src}
			alt="Glossyplace bracelet and necklace styled on a model"
			ratio="4 / 5"
			maxWidth={640}
			feather={3}
			overlay={0.5}
			scrimStyle="bottom"
			contentAlign="bottom"
			fit="cover"
			introFadeTo={0.28}
		>
			<div slot="intro" class="about-intro-content">
				<p class="about-lead">Because&hellip;</p>
			</div>
			<p class="reveal-quote">
				Because sometimes we choose jewellery for its beauty.<br />And sometimes, it feels as though it chooses us.
			</p>
		</ScrollMaskSection>

		<section class="about-closing">
			<p class="about-closing-word">Glossyplace</p>
			<p class="about-closing-tagline">Jewellery with Positive Energy</p>
			<a href="/shop" class="about-closing-cta">Shop the Collection</a>
		</section>
	</main>

	<div class="about-progress" aria-hidden="true">
		<div class="about-progress-track">
			<div class="about-progress-fill" id="about-progress-fill"></div>
		</div>
	</div>
</BaseLayout>

<style>
	.about {
		background: #fff;
	}

	.about-intro-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
	}

	.about-eyebrow {
		margin: 0;
		color: #b8a68a;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 3px;
		text-transform: uppercase;
	}

	.about-lead {
		margin: 0;
		max-width: 680px;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 34px;
		font-weight: 400;
		line-height: 1.35;
	}

	.about-text-section {
		display: flex;
		justify-content: center;
		padding: 140px 24px;
	}

	.about-text-inner {
		display: flex;
		max-width: 620px;
		flex-direction: column;
		gap: 28px;
	}

	.about-paragraph {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 24px;
		font-weight: 400;
		line-height: 1.6;
		text-align: center;
	}

	.about-closing {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 20px;
		padding: 180px 24px;
		text-align: center;
	}

	.about-closing-word {
		margin: 0;
		color: #111827;
		font-family: "Cormorant Garamond", serif;
		font-size: 48px;
		font-weight: 400;
		letter-spacing: 6px;
		text-transform: uppercase;
	}

	.about-closing-tagline {
		margin: 0 0 12px;
		color: #6b7280;
		font-family: "Manrope", sans-serif;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.about-closing-cta {
		padding: 16px 40px;
		border: 1px solid #111827;
		background: #111827;
		color: #fff;
		font-family: "Manrope", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	@media (hover: hover) {
		.about-closing-cta:hover {
			background: #fff;
			color: #111827;
		}
	}

	/* Fixed at the right edge for the whole page — the site hides its
	   native scrollbar everywhere (see global.css), so on a long,
	   section-by-section page like this one there's otherwise no visual
	   sense of how much is left. Anchored to the large-viewport unit
	   (with plain vh as a fallback) rather than the live viewport: on
	   mobile the browser's address bar collapses right as scrolling
	   starts, growing the live viewport height, which would otherwise
	   shift a plain top:50%/vh center downward mid-scroll. */
	.about-progress {
		position: fixed;
		top: 50vh;
		top: 50lvh;
		right: 24px;
		z-index: 15;
		transform: translateY(-50%);
		height: 40vh;
		height: 40lvh;
		pointer-events: none;
	}

	.about-progress-track {
		position: relative;
		width: 3px;
		height: 100%;
		background: rgba(17, 24, 39, 0.18);
	}

	.about-progress-fill {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: #b8a68a;
		transform: scaleY(0);
		transform-origin: top;
	}

	@media (max-width: 640px) {
		.about-progress {
			right: 14px;
			height: 30vh;
			height: 30lvh;
		}
	}

	@media (max-width: 1024px) {
		.about-intro {
			min-height: 50vh;
			padding: 120px 24px;
		}

		.about-lead {
			font-size: 26px;
		}

		.about-text-section {
			padding: 80px 24px;
		}

		.about-paragraph {
			font-size: 20px;
		}

		.about-closing {
			padding: 120px 24px;
		}

		.about-closing-word {
			font-size: 34px;
			letter-spacing: 4px;
		}
	}
</style>

<style is:global>
	.reveal-quote {
		max-width: 640px;
		margin: 0;
		color: #fff;
		font-family: "Cormorant Garamond", serif;
		font-size: 34px;
		font-weight: 400;
		line-height: 1.4;
		text-align: center;
		text-shadow: 0 2px 28px rgba(0, 0, 0, 0.45);
	}

	.reveal-quote-compact {
		max-width: 540px;
		font-size: 27px;
		line-height: 1.45;
	}

	@media (max-width: 1024px) {
		.reveal-quote {
			font-size: 24px;
		}

		.reveal-quote-compact {
			font-size: 20px;
			line-height: 1.5;
		}
	}
</style>

<script>
	import Lenis from "lenis";
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	// Smooth inertia scrolling for this scroll-driven page. Desktop wheel
	// input only by default (syncTouch stays off) — mobile keeps native
	// touch scrolling, which is already tuned (see ScrollMaskSection).
	const lenis = new Lenis();

	lenis.on("scroll", ScrollTrigger.update);

	gsap.ticker.add((time) => {
		lenis.raf(time * 1000);
	});

	gsap.ticker.lagSmoothing(0);

	// Vertical scroll-progress indicator, filling top-to-bottom as the
	// page scrolls from 0 to the very end.
	const progressFill = document.getElementById("about-progress-fill");
	if (progressFill) {
		ScrollTrigger.create({
			start: 0,
			end: "max",
			onUpdate: (self) => {
				// A short tween instead of an instant set smooths over any
				// abrupt jumps — e.g. a fast mobile flick reporting several
				// scroll positions in one frame, or the rubber-band bounce
				// at the very bottom of the page.
				gsap.to(progressFill, { scaleY: self.progress, duration: 0.2, ease: "power1.out", overwrite: "auto" });
			},
		});
	}

	// Fade the whole bar out once the site footer comes into view — it's
	// fixed to the viewport, so without this it keeps floating on top of
	// the footer for the rest of the scroll instead of stopping where
	// the page's own content ends.
	const progressBar = document.querySelector<HTMLElement>(".about-progress");
	const footer = document.querySelector(".site-footer");
	if (progressBar && footer) {
		ScrollTrigger.create({
			trigger: footer,
			start: "top bottom",
			onEnter: () => gsap.to(progressBar, { opacity: 0, duration: 0.3, overwrite: "auto" }),
			onLeaveBack: () => gsap.to(progressBar, { opacity: 1, duration: 0.3, overwrite: "auto" }),
		});
	}
</script>
